{
    "name": "edwardcaret/laravel-storage-copy",
    "description": "Laravel Artisan command for copying files between Laravel Filesystem/Storage disks.",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filesystem",
        "flysystem",
        "storage",
        "file",
        "copy",
        "sync",
        "migrate",
        "s3"
    ],
    "homepage": "https://github.com/edwardcaret/laravel-storage-copy",
    "authors": [
        {
            "name": "sykez",
            "email": "hello@sykez.com"
        },
        {
            "name": "edwardcaret",
            "email": "edward@caret.net"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^7.4 || ^8",
        "league/flysystem": "~1.0 || ^3.0",
        "league/flysystem-aws-s3-v3": "^1.0 || ^3.0",
        "laravel/framework": "^5.6 || ^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sykez\\StorageCopy\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sykez\\StorageCopy\\ServiceProvider"
            ]
        }
    }
}
